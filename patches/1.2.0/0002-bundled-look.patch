+#if defined(_WIN32)
+// With client side decorations (headerbar / menubar in titlebar) GDK clears every WM style bit,
+// so clicking the taskbar button can no longer minimise the window. Keep the two bits that the
+// shell needs; without WS_CAPTION they draw nothing.
+static GdkFilterReturn _win32_csd_style_filter(GdkXEvent* pXEvent, GdkEvent*/*pEvent*/, gpointer/*data*/)
+{
+    MSG* pMsg = static_cast<MSG*>(pXEvent);
+    if (WM_STYLECHANGING == pMsg->message and GWL_STYLE == static_cast<int>(pMsg->wParam)) {
+        auto pStyle = reinterpret_cast<STYLESTRUCT*>(pMsg->lParam);
+        if (0 == (pStyle->styleNew & WS_CAPTION)) {
+            pStyle->styleNew |= (WS_MINIMIZEBOX | WS_SYSMENU);
+        }
+    }
+    return GDK_FILTER_CONTINUE;
+}
+
+void CtMiscUtil::win32_csd_keep_taskbar_minimise(GdkWindow* pGdkWindow)
+{
+    static const char* filterKey{"ct-win32-csd-style-filter"};
+    if (not pGdkWindow or g_object_get_data(G_OBJECT(pGdkWindow), filterKey)) {
+        return;
+    }
+    g_object_set_data(G_OBJECT(pGdkWindow), filterKey, GINT_TO_POINTER(1));
+    gdk_window_add_filter(pGdkWindow, _win32_csd_style_filter, nullptr);
+    HWND hWnd = static_cast<HWND>(gdk_win32_window_get_handle(pGdkWindow));
+    const LONG style = GetWindowLong(hWnd, GWL_STYLE);
+    if (0 == (style & WS_CAPTION)) {
+        SetWindowLong(hWnd, GWL_STYLE, style | WS_MINIMIZEBOX | WS_SYSMENU);
+    }
+}
+#endif // _WIN32
