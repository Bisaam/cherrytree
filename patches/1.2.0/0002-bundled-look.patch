Subject: Bundled look and settings for the Windows and macOS builds

- Windows/macOS: own settings folder, %APPDATA%\CherryTree / ~/Library/Application Support/CherryTree,
  so a config.cfg / icons folder of a regular CherryTree install can't override the bundled look
- first run: start from <datadir>/data/config-default.cfg (the bundled default settings)
- Windows/macOS: default to fontconfig+FreeType text rendering (PANGOCAIRO_BACKEND=fc), as on Linux
- Windows/macOS: default to client side decorations (GTK_CSD=1) so the bundled GTK theme draws every titlebar
- Windows/macOS: re-apply the bundled etc/gtk-3.0/settings.ini at application priority, as GDK otherwise
  forces the system font (and on Windows ClearType-style hinting) over it
- macOS: find the data folders inside CherryTree.app (Contents/Resources/share/cherrytree, share/locale)
- Windows: keep WS_MINIMIZEBOX|WS_SYSMENU on the CSD main window so the taskbar button minimises it (#1917)

Set CHERRYTREE_NATIVE_LOOK=1 to disable the environment defaults.
---
diff --git a/src/ct/ct_app.cc b/src/ct/ct_app.cc
index 48c45af..4ca2ccf 100644
--- a/src/ct/ct_app.cc
+++ b/src/ct/ct_app.cc
@@ -68,11 +68,70 @@ static void kill_callback_handler(int signum)
 }
 
 // small optimization: second instance doesn't need all UI initialization, so we call it on the real startup
+#if defined(_WIN32) || defined(__APPLE__)
+// Bundled look: GDK on Windows and macOS reports the system values for gtk-font-name (Segoe UI 9,
+// the macOS system font) and, on Windows, for gtk-xft-hintstyle/rgba/antialias and
+// gtk-overlay-scrolling. Those take priority over the bundled etc/gtk-3.0/settings.ini, so re-apply
+// that file at application priority to use the bundled fonts and font rendering
+// (skipped with CHERRYTREE_NATIVE_LOOK=1).
+static void _apply_bundled_gtk_settings_ini()
+{
+    if (g_getenv("CHERRYTREE_NATIVE_LOOK")) {
+        return;
+    }
+#if defined(_WIN32)
+    // e.g. cherrytree_1.7.2_win64_portable\ucrt64
+    gchar* pTopDir = g_win32_get_package_installation_directory_of_module(NULL);
+#else // __APPLE__
+    // e.g. CherryTree.app/Contents/Resources (the datadir is Contents/Resources/share/cherrytree)
+    gchar* pTopDir = g_strdup(fs::get_cherrytree_datadir().parent_path().parent_path().string().c_str());
+#endif // __APPLE__
+    if (not pTopDir) {
+        return;
+    }
+    gchar* pIniPath = g_build_filename(pTopDir, "etc", "gtk-3.0", "settings.ini", NULL);
+    g_free(pTopDir);
+    GKeyFile* pKeyFile = g_key_file_new();
+    if (g_key_file_load_from_file(pKeyFile, pIniPath, G_KEY_FILE_NONE, NULL)) {
+        GtkSettings* pSettings = gtk_settings_get_default();
+        gsize numKeys{0};
+        gchar** ppKeys = g_key_file_get_keys(pKeyFile, "Settings", &numKeys, NULL);
+        for (gsize i = 0; ppKeys and i < numKeys; ++i) {
+            GParamSpec* pSpec = g_object_class_find_property(G_OBJECT_GET_CLASS(pSettings), ppKeys[i]);
+            if (not pSpec or (pSpec->flags & G_PARAM_DEPRECATED)) {
+                continue;
+            }
+            const GType valueType = G_PARAM_SPEC_VALUE_TYPE(pSpec);
+            if (G_TYPE_STRING == valueType) {
+                gchar* pValue = g_key_file_get_string(pKeyFile, "Settings", ppKeys[i], NULL);
+                if (pValue) {
+                    g_object_set(pSettings, ppKeys[i], pValue, NULL);
+                    g_free(pValue);
+                }
+            }
+            else if (G_TYPE_INT == valueType) {
+                g_object_set(pSettings, ppKeys[i], g_key_file_get_integer(pKeyFile, "Settings", ppKeys[i], NULL), NULL);
+            }
+            else if (G_TYPE_BOOLEAN == valueType) {
+                g_object_set(pSettings, ppKeys[i], g_key_file_get_boolean(pKeyFile, "Settings", ppKeys[i], NULL), NULL);
+            }
+        }
+        g_strfreev(ppKeys);
+    }
+    g_key_file_unref(pKeyFile);
+    g_free(pIniPath);
+}
+#endif // _WIN32 || __APPLE__
+
