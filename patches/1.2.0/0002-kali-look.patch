Subject: Kali look defaults for the Windows (and macOS) builds

- Windows/macOS: settings in <user config dir>/cherrytree-kali, seeded on first run from
  <datadir>/data/config-kali.cfg (the kali-themes /etc/skel defaults)
- Windows/macOS: default to fontconfig+FreeType text rendering (PANGOCAIRO_BACKEND=fc) like on Kali
- Windows: default to client side decorations (GTK_CSD=1) so the Kali-Dark theme draws every titlebar
- Windows: re-apply <prefix>/etc/gtk-3.0/settings.ini at application priority, as GDK otherwise
  forces the Windows font (Segoe UI 9) and ClearType-style hinting over it
- Windows: keep WS_MINIMIZEBOX|WS_SYSMENU on the CSD main window so the taskbar button minimises it

Set CHERRYTREE_NATIVE_LOOK=1 to disable the environment defaults.
---
diff --git a/src/ct/ct_app.cc b/src/ct/ct_app.cc
index 48c45af..dfbcd16 100644
--- a/src/ct/ct_app.cc
+++ b/src/ct/ct_app.cc
@@ -68,11 +68,63 @@ static void kill_callback_handler(int signum)
 }
 
 // small optimization: second instance doesn't need all UI initialization, so we call it on the real startup
+#if defined(_WIN32)
+// Kali look: GDK on Windows reports the Windows values for gtk-font-name (Segoe UI 9),
+// gtk-xft-hintstyle/rgba/antialias and gtk-overlay-scrolling, and those take priority over
+// <prefix>/etc/gtk-3.0/settings.ini. Re-apply that file at application priority so the Kali
+// fonts and font rendering are used (skipped with CHERRYTREE_NATIVE_LOOK=1).
+static void _win32_apply_gtk_settings_ini()
+{
+    if (g_getenv("CHERRYTREE_NATIVE_LOOK")) {
+        return;
+    }
+    gchar* pTopDir = g_win32_get_package_installation_directory_of_module(NULL);
+    if (not pTopDir) {
+        return;
+    }
+    gchar* pIniPath = g_build_filename(pTopDir, "etc", "gtk-3.0", "settings.ini", NULL);
+    g_free(pTopDir);
+    GKeyFile* pKeyFile = g_key_file_new();
+    if (g_key_file_load_from_file(pKeyFile, pIniPath, G_KEY_FILE_NONE, NULL)) {
+        GtkSettings* pSettings = gtk_settings_get_default();
+        gsize numKeys{0};
+        gchar** ppKeys = g_key_file_get_keys(pKeyFile, "Settings", &numKeys, NULL);
+        for (gsize i = 0; ppKeys and i < numKeys; ++i) {
+            GParamSpec* pSpec = g_object_class_find_property(G_OBJECT_GET_CLASS(pSettings), ppKeys[i]);
+            if (not pSpec or (pSpec->flags & G_PARAM_DEPRECATED)) {
+                continue;
+            }
+            const GType valueType = G_PARAM_SPEC_VALUE_TYPE(pSpec);
+            if (G_TYPE_STRING == valueType) {
+                gchar* pValue = g_key_file_get_string(pKeyFile, "Settings", ppKeys[i], NULL);
+                if (pValue) {
+                    g_object_set(pSettings, ppKeys[i], pValue, NULL);
+                    g_free(pValue);
+                }
+            }
+            else if (G_TYPE_INT == valueType) {
+                g_object_set(pSettings, ppKeys[i], g_key_file_get_integer(pKeyFile, "Settings", ppKeys[i], NULL), NULL);
+            }
+            else if (G_TYPE_BOOLEAN == valueType) {
+                g_object_set(pSettings, ppKeys[i], g_key_file_get_boolean(pKeyFile, "Settings", ppKeys[i], NULL), NULL);
+            }
+        }
+        g_strfreev(ppKeys);
+    }
+    g_key_file_unref(pKeyFile);
+    g_free(pIniPath);
+}
+#endif // _WIN32
+
 void CtApp::_on_startup()
 {
     if (_initDone) return;
     _initDone = true;
 
+#if defined(_WIN32)
+    _win32_apply_gtk_settings_ini();
+#endif // _WIN32
+
 #if defined(_WIN32)
     (void)fs::alter_TEXMFROOT_env_var();
     (void)fs::alter_PATH_env_var();
